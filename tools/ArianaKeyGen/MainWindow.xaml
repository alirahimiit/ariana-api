<Window x:Class="ArianaKeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیر لایسنس آریانا"
        Height="740" Width="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        FlowDirection="RightToLeft">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ═══ هدر ═══ -->
		<Border Grid.Row="0" Style="{StaticResource Card}">
			<StackPanel>
				<TextBlock Text="🔐 مدیر لایسنس آریانا"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
				<TextBlock Text="ابزار ساخت کلید و لایسنس نرم‌افزار"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
			</StackPanel>
		</Border>

		<!-- ═══ تب‌ها ═══ -->
		<TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">

			<!-- ═══════ تب ۱: ساخت لایسنس ═══════ -->
			<TabItem Header="📜 ساخت لایسنس">
				<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
					<StackPanel>

						<Border Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Text="اطلاعات مشتری"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,16"/>

								<TextBlock Text="نام مشتری *" Style="{StaticResource AppLabel}"/>
								<TextBox x:Name="TxtCustomerName"
                                         Style="{StaticResource AppTextBox}"
                                         Margin="0,0,0,12"/>

								<TextBlock Text="کد مشتری *" Style="{StaticResource AppLabel}"/>
								<TextBox x:Name="TxtCustomerId"
                                         Style="{StaticResource AppTextBox}"
                                         Margin="0,0,0,12"/>

								<TextBlock Text="کدهای سازمان مجاز * (با کاما جدا کن: 1,2,5)"
                                           Style="{StaticResource AppLabel}"/>
								<TextBox x:Name="TxtOrgs"
                                         Style="{StaticResource AppTextBox}"
                                         Margin="0,0,0,12"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0">
										<TextBlock Text="تاریخ انقضا" Style="{StaticResource AppLabel}"/>
										<TextBox x:Name="TxtExpiresAt"
                                                 Style="{StaticResource AppTextBox}"
                                                 Text="1405/12/29"/>
									</StackPanel>

									<StackPanel Grid.Column="2">
										<TextBlock Text="توضیحات (اختیاری)" Style="{StaticResource AppLabel}"/>
										<TextBox x:Name="TxtNotes"
                                                 Style="{StaticResource AppTextBox}"/>
									</StackPanel>
								</Grid>
							</StackPanel>
						</Border>

						<Border Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Text="محل ذخیره"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,16"/>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<TextBox x:Name="TxtOutputPath"
                                             Grid.Column="0"
                                             Style="{StaticResource AppTextBox}"
                                             IsReadOnly="True"
                                             Background="#F9FAFB"/>

									<Button Grid.Column="1"
                                            Content="📁 انتخاب مسیر"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0"
                                            Click="BtnBrowse_Click"/>
								</Grid>
							</StackPanel>
						</Border>

						<Button Content="✍️ ساخت لایسنس"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="15"
                                Padding="20,12"
                                Click="BtnCreateLicense_Click"/>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- ═══════ تب ۲: کلیدها ═══════ -->
			<TabItem Header="🔑 کلیدها">
				<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
					<StackPanel>

						<Border Style="{StaticResource Card}">
							<StackPanel>
								<TextBlock Text="وضعیت کلیدها"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,0,16"/>

								<Grid Margin="0,0,0,12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="130"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<TextBlock Text="private.key:"
                                               Style="{StaticResource AppLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0"/>

									<TextBlock x:Name="TxtPrivateStatus"
                                               Grid.Column="1"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
								</Grid>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="130"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<TextBlock Text="public.key:"
                                               Style="{StaticResource AppLabel}"
                                               VerticalAlignment="Center"
                                               Margin="0"/>

									<TextBlock x:Name="TxtPublicStatus"
                                               Grid.Column="1"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
								</Grid>
							</StackPanel>
						</Border>

						<Border Background="#FEF3C7"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,16"
                                BorderBrush="#FDE68A"
                                BorderThickness="1">
							<StackPanel>
								<TextBlock Text="⚠️ هشدار مهم"
                                           FontWeight="Bold"
                                           Foreground="#92400E"
                                           Margin="0,0,0,6"/>
								<TextBlock TextWrapping="Wrap"
                                           Foreground="#92400E"
                                           FontSize="12"
                                           Text="هر بار که کلید بسازی، همه‌ی لایسنس‌های قبلی باطل می‌شن و باید فایل PublicKey رو توی اپ Web آپدیت کنی. این کار رو فقط یک بار انجام بده!"/>
							</StackPanel>
						</Border>

						<Button Content="🔐 ساخت جفت کلید جدید"
                                Style="{StaticResource GhostButton}"
                                FontSize="14"
                                Padding="20,12"
                                Click="BtnGenerateKeys_Click"/>

						<Button x:Name="BtnCopyPublicKey"
                                Content="📋 کپی public.key در کلیپ‌بورد"
                                Style="{StaticResource GhostButton}"
                                FontSize="14"
                                Padding="20,12"
                                Margin="0,12,0,0"
                                Click="BtnCopyPublicKey_Click"/>

					</StackPanel>
				</ScrollViewer>
			</TabItem>

		</TabControl>

		<!-- ═══ نوار وضعیت ═══ -->
		<Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                CornerRadius="12"
                Padding="16,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="0,12,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="TxtStatusIcon"
                           Grid.Column="0"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Text="ℹ️"/>

				<TextBlock x:Name="TxtStatus"
                           Grid.Column="1"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="آماده"/>
			</Grid>
		</Border>
	</Grid>
</Window>